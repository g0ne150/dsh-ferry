{
  "name": "dsh-ferry",
  "version": "0.1.7",
  "type": "module",
  "description": "Move Sessions and their Workspace between DSH instances over any reachable network.",
  "license": "MIT",
  "author": "Zapan Gao <g0ne150@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0ne150/dsh-ferry.git"
  },
  "homepage": "https://github.com/g0ne150/dsh-ferry#readme",
  "bugs": {
    "url": "https://github.com/g0ne150/dsh-ferry/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "plugin",
    "session",
    "workspace",
    "transfer"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0",
    "node": ">=20.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "prepublishOnly": "npm test"
  }
}
